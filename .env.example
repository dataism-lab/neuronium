# =============================================================================
# NeuroniumAgent — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
#
# All variables are optional unless marked [REQUIRED].
# Variables prefixed with NEURONIUM_ override the corresponding
# settings from neuronium.toml (see CONFIG_SPEC for details).
# =============================================================================

# ---------------------------------------------------------------------------
# LLM (Language Model) — [REQUIRED for live mode]
# ---------------------------------------------------------------------------
# OpenAI-compatible API key. Without this, live runs will fail immediately
# with "LLM unavailable (strict_fail)". Not needed for replay mode.
NEURONIUM_OPENAI_API_KEY=sk-...

# LLM provider (default: openai)
# NEURONIUM_LLM_PROVIDER=openai

# Model name (default: gpt-4.1-mini)
# NEURONIUM_LLM_MODEL=gpt-4.1-mini

# Custom base URL for OpenAI-compatible endpoints (e.g. local proxy)
# NEURONIUM_LLM_BASE_URL=

# ---------------------------------------------------------------------------
# Project
# ---------------------------------------------------------------------------
# NEURONIUM_PROJECT_NAME=neuronium
# NEURONIUM_PROJECT_DATA_DIR=.neuronium

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Blob backend: fs_cas | s3
# NEURONIUM_STORAGE_BLOB_BACKEND=fs_cas
# NEURONIUM_STORAGE_FS_CAS_ROOT=.neuronium/blobs

# Index backend: sqlite | postgres
# NEURONIUM_STORAGE_INDEX_BACKEND=sqlite
# NEURONIUM_STORAGE_SQLITE_PATH=.neuronium/index.sqlite3

# PostgreSQL (only if index backend = postgres)
# NEURONIUM_STORAGE_POSTGRES_DSN=postgresql://user:pass@localhost:5432/neuronium
# NEURONIUM_STORAGE_POSTGRES_SCHEMA=neuronium_agent

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Execution mode: batch | supervised
# NEURONIUM_RUNTIME_MODE=batch

# ---------------------------------------------------------------------------
# Queue (Redis / RQ)
# ---------------------------------------------------------------------------
# NEURONIUM_QUEUE_ENABLED=false
# NEURONIUM_QUEUE_REDIS_URL=redis://localhost:6379/0
# NEURONIUM_QUEUE_QUEUE_NAME=neuronium

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# NEURONIUM_LOGGING_LEVEL=INFO
